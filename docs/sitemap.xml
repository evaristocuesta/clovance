---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- if p.sitemap != false -%}
{%- if p.url == '/' or p.url contains '.html' %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
{%- endif -%}
{%- endif -%}
{%- endfor %}
</urlset>
