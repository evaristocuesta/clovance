---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.pages -%}
{%- if p.sitemap != false -%}
{%- if p.url == '/' or p.url contains '.html' -%}
{%- assign en_url = p.url -%}
{%- assign es_url = p.translation -%}
{%- if p.lang == 'es' -%}
{%- assign en_url = p.translation -%}
{%- assign es_url = p.url -%}
{%- endif %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
{%- if p.translation %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ en_url | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="es" href="{{ es_url | absolute_url }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ en_url | absolute_url }}" />
{%- endif %}
  </url>
{%- endif -%}
{%- endif -%}
{%- endfor %}
</urlset>
